<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form (in sign_oca)</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="0" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    name="sign_oca"
                    data-string="Sign Oca"
                    string="Sign Oca"
                    groups="sign_oca.sign_oca_group_admin"
                >
                    <block id="sign_oca_requests" title="Sign Requests">
                        <setting
                            class="col-xs-12 col-md-6 o_setting_box"
                            help="Once all signers have signed the request, a copy of the final document will be sent to each of them."
                        >
                            <field name="sign_oca_send_sign_request_copy" />
                        </setting>
                        <setting
                            class="col-xs-12 col-md-12 o_setting_box"
                            help="Automatically send email reminders to signers who have not yet signed."
                        >
                            <div class="o_setting_left_pane">
                                <field name="sign_oca_reminder_enabled" />
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="sign_oca_reminder_enabled" />
                                <div class="text-muted">
                                    When enabled, a daily cron job sends reminders to unsigned signers.
                                </div>
                                <div class="mt8" invisible="not sign_oca_reminder_enabled">
                                    <label
                                        for="sign_oca_reminder_interval_days"
                                        string="Send every"
                                    />
                                    <field
                                        name="sign_oca_reminder_interval_days"
                                        class="o_hr_narrow_field d-inline"
                                    />
                                    <span> days</span>
                                </div>
                            </div>
                        </setting>
                        <setting
                            class="col-xs-12 col-md-6 o_setting_box"
                            help="Set a default expiration period for new sign requests. 0 means no expiration."
                        >
                            <div class="o_setting_right_pane">
                                <label
                                    for="sign_oca_validity_days"
                                    string="Default Validity Period"
                                />
                                <div class="mt8">
                                    <field
                                        name="sign_oca_validity_days"
                                        class="o_hr_narrow_field d-inline"
                                    />
                                    <span> days (0 = no expiration)</span>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="sign_oca_general_settings_act_window" model="ir.actions.act_window">
        <field name="name">General Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'sign_oca'}</field>
    </record>
    <menuitem
        name="General settings"
        id="sign_oca_general_settings_menu"
        parent="sign_oca_settings_menu"
        sequence="1"
        action="sign_oca_general_settings_act_window"
    />
</odoo>
